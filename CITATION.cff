    family-names: "Maroto Enríquez"
    affiliation: "Independent Institute of Transdisciplinary Research in Consciousness and Cosmos (IITRCC), Spain"
    email: "antonio@iitrcc.org"
    # Paste your ORCID here once registered at https://orcid.org (keep the full URL form):
    orcid: "https://orcid.org/0009-0005-8238-7310"
version: "0.2.0"
date-released: "2026-06-13"
license: MIT
